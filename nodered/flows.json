    {
        "id": "poll_zones",
        "type": "inject",
        "z": "civictwin_tab",
        "name": "Poll Zones (5s)",
        "props": [],
        "repeat": "5",
        "crontab": "",
        "once": true,
        "onceDelay": "3",
        "topic": "",
        "x": 130,
        "y": 300,
        "wires": [
            [
                "fetch_zones"
            ]
        ]
    },
    {
        "id": "fetch_zones",
        "type": "http request",
        "z": "civictwin_tab",
        "name": "GET /api/zones",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://backend:8000/api/zones",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "x": 320,
        "y": 300,
        "wires": [
            [
                "parse_zones"
            ]
        ]
    },
    {
        "id": "parse_zones",
        "type": "function",
        "z": "civictwin_tab",
        "name": "Parse Zone Data",
        "func": "var zones = msg.payload.zones || [];\nvar outputs = [];\n\nfor (var i = 0; i < 3 && i < zones.length; i++) {\n    var z = zones[i];\n    var level_pct = z.current_level_pct;\n    var level_cm = z.current_level_cm;\n    var rain_pct = z.rain_indicator_pct;\n    var rain_raw = z.rain_sensor_raw;\n    var status = z.sensor_status || 'unknown';\n    var source = (z.data_source || z.source || 'WOKWI_SIMULATED').toUpperCase();\n    var device = z.device_id || 'no device';\n    var state = z.live_data_state || 'CURRENT_DATA';\n    var isStale = z.is_stale === true;\n    var timestamp = z.telemetry_timestamp || z.last_update;\n    var ts = timestamp ? new Date(timestamp).toLocaleTimeString() : 'N/A';\n    \n    var statusBadge = '[ONLINE]';\n    if (state === 'WAITING_FOR_WOKWI_DATA') statusBadge = '[WAITING FOR WOKWI DATA]';\n    else if (status === 'offline') statusBadge = '[OFFLINE]';\n    else if (isStale || status === 'stale') statusBadge = '[STALE]';\n    else if (status === 'invalid') statusBadge = '[INVALID]';\n    \n    var rainText = rain_pct === null || rain_pct === undefined\n        ? 'Simulated rain indicator: unavailable (uncalibrated, not mm)'\n        : 'Simulated rain indicator: ' + Number(rain_pct).toFixed(1) + '% (ADC ' + rain_raw + ') — uncalibrated, not mm';\n    var levelText = level_cm === null || level_pct === null\n        ? 'no live water-level measurement'\n        : Number(level_cm).toFixed(1) + ' cm (' + Number(level_pct).toFixed(1) + '%)';\n    outputs.push({ payload: level_pct === null ? null : level_pct, topic: z.zone_id });\n    outputs.push({ payload: statusBadge + ' [' + source + '] ' + device + ' — ' + levelText + ' @ ' + ts });\n    outputs.push({ payload: rainText, topic: z.zone_id });\n}\n\nreturn outputs;",
        "outputs": 9,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 530,
        "y": 300,
        "wires": [
            [
                "zone1_gauge"
            ],
            [
                "zone1_text"
            ],
            [
                "zone1_rain"
            ],
            [
                "zone2_gauge"
            ],
            [
                "zone2_text"
            ],
            [
                "zone2_rain"
            ],
