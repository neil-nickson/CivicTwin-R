    {
        "id": "parse_alerts",
        "type": "function",
        "z": "civictwin_tab",
        "name": "Format Alerts",
        "func": "var alerts = msg.payload.alerts || [];\nif (alerts.length === 0) {\n    msg.payload = 'No active alerts';\n    return msg;\n}\n\nvar lines = alerts.slice(-5).reverse().map(function(a) {\n    var icon = a.alert_level === 'critical' ? '[CRITICAL]' : '[WARNING]';\n    return icon + ' ' + a.zone_id + ': ' + a.water_level_pct.toFixed(1) + '% \u2014 ' + a.alert_level;\n});\n\nmsg.payload = lines.join('\\n');\nreturn msg;",
        "outputs": 1,
        "x": 540,
        "y": 1020,
        "wires": [
            [
                "alerts_text"
            ]
        ]
