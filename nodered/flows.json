    {
        "id": "poll_health",
        "type": "inject",
        "z": "civictwin_tab",
        "name": "Poll Health (10s)",
        "props": [],
        "repeat": "10",
        "crontab": "",
        "once": true,
        "onceDelay": "2",
        "topic": "",
        "x": 130,
        "y": 60,
        "wires": [
            [
                "fetch_health"
            ]
        ]
    },
    {
        "id": "fetch_health",
        "type": "http request",
        "z": "civictwin_tab",
        "name": "GET /health",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://backend:8000/health",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "x": 320,
        "y": 60,
        "wires": [
            [
                "parse_health"
            ]
        ]
    },
    {
        "id": "parse_health",
        "type": "function",
        "z": "civictwin_tab",
        "name": "Parse Health",
        "func": "var health = msg.payload;\nif (!health) { return null; }\n\nvar status = health.status || 'unknown';\nvar mqtt = health.mqtt_connected ? '[CONNECTED]' : '[DISCONNECTED]';\nvar records = health.records_stored || 0;\nvar ingestion = health.ingestion || {};\nvar stats = ingestion.stats || {};\n\n// System status text\nvar msg1 = { payload: status === 'healthy' ? '[HEALTHY]' : '[UNHEALTHY]' };\nvar msg2 = { payload: mqtt };\nvar msg3 = { payload: records };\nvar msg4 = { payload: stats.messages_valid || 0 };\nvar msg5 = { payload: (stats.messages_invalid || 0) + (stats.messages_duplicate || 0) };\nvar msg6 = { payload: ingestion.active_alerts || 0 };\n\nreturn [msg1, msg2, msg3, msg4, msg5, msg6];",
        "outputs": 6,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 510,
        "y": 60,
        "wires": [
            [
                "status_text"
            ],
            [
                "mqtt_status_text"
            ],
            [
                "records_gauge"
            ],
            [
                "valid_count"
            ],
            [
                "invalid_count"
            ],
            [
                "alert_count"
            ]
        ]
    },
