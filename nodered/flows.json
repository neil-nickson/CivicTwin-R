    {
        "id": "parse_scenario_status",
        "type": "function",
        "z": "civictwin_tab",
        "name": "Parse Status",
        "func": "var s = msg.payload;\nif (!s || !s.scenario_id) return null;\n\nvar progress = s.progress_pct || 0;\nvar status_str = s.scenario_name + ' \u2014 ' + progress.toFixed(0) + '%';\nif (s.is_complete) status_str += ' [COMPLETE]';\nelse if (s.is_running) status_str += ' [RUNNING]';\n\nvar msg1 = { payload: status_str };\nvar msg2 = { payload: progress };\n\nreturn [msg1, msg2];",
        "outputs": 2,
        "x": 570,
        "y": 780,
        "wires": [
