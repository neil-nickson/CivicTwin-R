# CivicTwin-R Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env before starting Docker:
#   cp .env.example .env
#
# When running with docker compose, the backend container reads these values.
# When running the backend directly on your Mac (without Docker), the same
# variables are read from this file via python-dotenv.
# ─────────────────────────────────────────────────────────────────────────────

# ── MQTT Broker ───────────────────────────────────────────────────────────────
# Backend MQTT connection. For EMQX Cloud, use the assigned TLS hostname
# and port 8883. Keep the password only in the untracked root .env file.
MQTT_BROKER_HOST=wfde4d21.ala.asia-southeast1.emqxsl.com
MQTT_BROKER_PORT=8883
MQTT_USERNAME=civictwin_backend
MQTT_PASSWORD=replace-with-emqx-password
MQTT_CLIENT_ID=civictwin_backend_01
MQTT_TLS_ENABLED=true
# Empty uses Python's system/default trusted CA certificates.
MQTT_TLS_CA_FILE=
MQTT_TOPIC_PREFIX=civictwin/v1

# Live dashboard mode
# Docker Wokwi mode overrides these values in docker-compose.yml.
PYTHON_SIMULATOR_ENABLED=true
LIVE_TELEMETRY_SOURCE=

# ── InfluxDB ──────────────────────────────────────────────────────────────────
# Docker mode: overridden to http://influxdb:8086 inside docker-compose.yml.
# Standalone Mac mode: InfluxDB UI accessible at http://localhost:8086.
INFLUXDB_URL=http://localhost:8086

# Token must match DOCKER_INFLUXDB_INIT_ADMIN_TOKEN in docker-compose.yml.
# Change this to a strong random string for anything beyond local development.
INFLUXDB_TOKEN=civictwin-dev-token

INFLUXDB_ORG=civictwin
INFLUXDB_BUCKET=telemetry

# Set to true to write telemetry to InfluxDB in parallel with SQLite.
# Docker mode: set to true (InfluxDB container is running).
# Standalone Mac mode without InfluxDB: leave false — SQLite handles all data.
INFLUXDB_ENABLED=true

# ── Backend API ───────────────────────────────────────────────────────────────
# Docker mode: API_HOST is overridden to 0.0.0.0 in docker-compose.yml.
# Standalone Mac mode: 127.0.0.1 binds only to the loopback interface.
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false
LOG_LEVEL=INFO

# ── Digital Twin ──────────────────────────────────────────────────────────────
TWIN_TIME_STEP_SEC=5
TWIN_DEFAULT_SCENARIO=normal
RANDOM_SEED=42

# ── Storage Mode ──────────────────────────────────────────────────────────────
# Options: sqlite | influxdb | memory
# "sqlite"   — primary operational store; always available.
# "influxdb" — writes to InfluxDB; falls back to SQLite if unavailable.
# "memory"   — ephemeral; data lost on restart (testing only).
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=data/civictwin.db

# ── Node-RED ──────────────────────────────────────────────────────────────────
NODERED_PORT=1880
